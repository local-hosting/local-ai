{
  "name": "@local-hosting/local-ai",
  "packageManager": "yarn@4.18.1",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI: loopback map + constrained compose for many apps (no geo required).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local-hosting/local-ai.git"
  },
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prevalidate": "yarn workspace @local-hosting/compose build && yarn workspace @local-hosting/vocab build",
    "validate": "yarn typecheck",
    "test": "vitest run",
    "pretest": "yarn workspace @local-hosting/compose build",
    "ci": "yarn validate && yarn test",
    "test:watch": "vitest",
    "start": "node --import tsx src/api/start-server.ts",
    "start:boot": "sh runtime/boot.sh",
    "eval": "node --import tsx eval/run-eval.ts"
  },
  "dependencies": {
    "@local-hosting/compose": "0.1.0",
    "@local-hosting/vocab": "0.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
